# ==============================================================================
# STUWORK - CẤU HÌNH BIẾN MÔI TRƯỜNG (SUPABASE & NEXT.JS)
# Sao chép file này thành .env.local và điền thông tin từ Supabase Dashboard
# Tuyệt đối KHÔNG commit file .env.local lên GitHub!
# ==============================================================================

# URL Project Supabase (VD: https://abcdefghijklm.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Anon / Publishable Key của Supabase (an toàn cho phía trình duyệt khi đã bật RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service Role Key (CHỈ dùng ở phía Server khi thật sự cần thiết - KHÔNG bao giờ thêm NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# URL ứng dụng (dùng cho Auth Redirect URLs khi xác thực email / đặt lại mật khẩu)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
